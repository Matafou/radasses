# Copie ce fichier en `.env` et renseigne les valeurs depuis
# ton projet Supabase : Settings → API.
# Ces deux valeurs sont PUBLIQUES (embarquées dans le front) — c'est normal :
# la sécurité vient des Row Level Security policies, pas du secret de la clé.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
