# Copie ce fichier en `.env`.
#
# Dev local : projet `demo-…` = ÉMULATEURS Firebase (`npm run emulators`), clé factice.
# Prod : valeurs du projet Firebase (console → Paramètres du projet → Général → Vos
# applications → Web). Ces valeurs sont PUBLIQUES (embarquées dans le front) — c'est
# normal : la sécurité vient des règles Firestore (`firestore.rules`), pas de la clé.
PUBLIC_FIREBASE_API_KEY=demo-key
PUBLIC_FIREBASE_PROJECT_ID=demo-radasses
